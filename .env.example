# Browser-safe public settings only. Populate through the Vercel project/build configuration.
# Do not put service-role keys, database passwords, or OAuth secrets in this file.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Server-only settings, if the API/worker is deployed separately:
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ledgerly
RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com
